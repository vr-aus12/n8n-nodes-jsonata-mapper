{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["customer", "order"],
  "properties": {
    "customer": {
      "type": "object",
      "required": ["firstName", "email"],
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "order": {
      "type": "object",
      "required": ["total"],
      "properties": {
        "total": { "type": "string" }
      }
    }
  }
}
